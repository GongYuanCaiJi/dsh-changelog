{
  "name": "dsh-changelog",
  "version": "0.1.0",
  "description": "自动生成发布说明（移植自 @noice-tech/pi-changelog）",
  "type": "module",
  "license": "MIT",
  "author": "GongYuanCaiJi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GongYuanCaiJi/dsh-changelog.git"
  },
  "homepage": "https://github.com/GongYuanCaiJi/dsh-changelog#readme",
  "bugs": {
    "url": "https://github.com/GongYuanCaiJi/dsh-changelog/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "changelog",
    "release-notes",
    "changelog-generator",
    "release-notes-generator",
    "git",
    "github",
    "privacy"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "src",
    "prompts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck",
    "prepack": "test -d dist || { echo 'Error: dist/ missing. Run npm run build first.' && exit 1; }"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
